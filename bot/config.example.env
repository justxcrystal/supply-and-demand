BOT_MODE=paper
BOT_SYMBOLS=XAUUSD,NAS100
BOT_TIMEFRAME=5
BOT_POLL_SECONDS=60
BOT_QTY=0.01
BOT_TP=6
BOT_REQUIRE_TREND=true

# Set these once to enable unattended TradeLocker execution.
# Atlas uses the ATLAS server/brand. The account ID stays in runtime config,
# not in source control.
BOT_LIVE_TRADING=false
BOT_TL_ENV=bsb
BOT_TL_BASE_URL=
BOT_TL_SERVER=ATLAS
BOT_TL_ACCOUNT_ID=
BOT_TL_EMAIL=
BOT_TL_PASSWORD=

# Optional fallback selector. Usually not needed because accNum is discovered
# automatically from BOT_TL_ACCOUNT_ID after login.
BOT_TL_ACCOUNT_NUM=
